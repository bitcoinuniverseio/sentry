{
  "name": "@bitcoinuniverse/sentry",
  "version": "0.1.0",
  "description": "SCIT/1 reference implementation. Marker codec, identity derivation, canonical CBOR, and the deterministic index state machine.",
  "license": "MIT",
  "packageManager": "npm@11.16.0",
  "author": "Bitcoin Universe",
  "homepage": "https://github.com/bitcoinuniverse/sentry#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitcoinuniverse/sentry.git"
  },
  "bugs": {
    "url": "https://github.com/bitcoinuniverse/sentry/issues"
  },
  "keywords": [
    "bitcoin",
    "psbt",
    "taproot",
    "op_return",
    "protocol",
    "conformance-vectors"
  ],
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "sentry": "cli.mjs"
  },
  "files": [
    "dist/",
    "cli.mjs",
    "vectors/",
    "sentry-protocol.md",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": "24.18.1",
    "npm": "11.16.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "test": "jest --config ./jest.config.cjs",
    "test:ci": "jest --config ./jest.config.cjs --ci --runInBand",
    "typecheck": "tsc --noEmit",
    "vectors:check": "node cli.mjs verify",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "22.10.2",
    "jest": "29.7.0",
    "ts-jest": "29.2.5",
    "typescript": "5.7.2"
  }
}
